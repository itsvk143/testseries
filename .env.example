# NextAuth & Admin
ADMIN_EMAILS="admin@example.com"
AUTH_SECRET="your_nextauth_auth_secret"
NEXTAUTH_SECRET="your_nextauth_secret"
NEXTAUTH_URL="https://www.polltest.in"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# MongoDB Database
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/testseries"

# Razorpay Payment Gateway (Production / Test)
# Public Key ID (shared with frontend checkout modal)
RAZORPAY_KEY_ID="rzp_test_xxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxx"

# Secret Key (server-side only, NEVER expose to client)
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Webhook Secret (server-side only, used to verify webhook signatures)
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Optional Price Overrides in INR (default is 999 for all exams)
# PAYMENT_AMOUNT_NEET=999
# PAYMENT_AMOUNT_JEE=999
# PAYMENT_AMOUNT_BITSAT=999
